{
  "name": "bolsa-v1",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma personal de gestión bursátil — IBEX, Europa, acciones",
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/run-dev.mjs",
    "doctor": "node scripts/dev-doctor.mjs",
    "doctor:fix": "node scripts/dev-doctor.mjs --fix-ports",
    "dev:verify": "node scripts/dev-verify.mjs",
    "startup:report": "node scripts/startup-report.mjs",
    "dev:web": "pnpm --filter @bolsa/web dev",
    "dev:arq-worker": "node scripts/dev-arq-worker.mjs",
    "dev:queue-poll-worker": "node scripts/dev-queue-poll-worker.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=@bolsa/web",
    "setup": "node scripts/setup.mjs",
    "dev:log": "node scripts/run-dev.mjs",
    "xtb:mock": "node scripts/xtb-bridge-mock.mjs",
    "test:log": "node scripts/run-tests.mjs",
    "health": "node scripts/health-check.mjs",
    "db:check": "node scripts/db-check.mjs",
    "db:ensure": "node scripts/db-ensure.mjs",
    "db:start": "node scripts/db-start.mjs",
    "db:generate": "pnpm --filter @bolsa/database db:generate",
    "db:migrate": "pnpm --filter @bolsa/database db:migrate",
    "db:push": "pnpm --filter @bolsa/database db:push",
    "db:seed": "pnpm --filter @bolsa/database db:seed",
    "db:studio": "pnpm --filter @bolsa/database db:studio",
    "test:py": "python -m pytest packages/py/domain/tests packages/py/market/tests packages/py/application/tests packages/py/analytics/tests apps/api-python/tests -q",
    "test:py:install": "pip install -e packages/py/domain -e packages/py/analytics -e packages/py/market -e packages/py/infrastructure -e packages/py/application -e \"apps/api-python[dev]\"",
    "test:optimize": "node scripts/research/verify_optimize_battery.mjs",
    "test:coach": "node scripts/research/verify_coach_battery.mjs",
    "test:coach:smoke": "python scripts/research/verify_core_p_api_smoke.py",
    "test:coach:api": "python -m pytest apps/api-python/tests/integration/test_core_p_multi_profile.py -q && python scripts/research/verify_core_p_api_smoke.py",
    "test:finalists:smoke": "python scripts/research/verify_finalists_roundtrip_smoke.py --replace",
    "test:play-chain": "node scripts/research/verify_play_chain_grf.mjs",
    "audit:ibex35": "python scripts/research/audit_ibex35_operativa.py --write-md",
    "audit:ibex35:missing": "python scripts/research/audit_ibex35_operativa.py --print-missing",
    "backfill:top-runids": "python scripts/research/backfill_top_runids.py",
    "test:fase2": "node scripts/research/verify_fase2_battery.mjs",
    "test:fa": "node scripts/research/verify_fa_battery.mjs",
    "test:fa:ops": "python scripts/research/verify_fa_operativa.py && python scripts/research/verify_fa_pipeline_bench.py",
    "test:fa:boot": "node scripts/research/verify_fa_boot.mjs",
    "audit:fa:coverage": "python scripts/research/audit_fa_coverage.py",
    "test:operativa": "node scripts/research/verify_operativa_battery.mjs",
    "test:operativa:smoke": "python scripts/research/verify_dia_d_api_smoke.py",
    "test:semi": "node scripts/research/verify_semi_demo_battery.mjs",
    "test:semi:smoke": "python scripts/research/verify_semi_demo_api_smoke.py",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  }
}
