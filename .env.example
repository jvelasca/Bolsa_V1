# Database (local Docker)
DATABASE_URL="postgresql://bolsa:bolsa_dev@localhost:5432/bolsa_v1?schema=public"

# API (TypeScript legacy â€” retirar tras cutover Python)
API_HOST=0.0.0.0
API_PORT=3001

# API Python (FastAPI â€” objetivo)
API_PYTHON_HOST=0.0.0.0
API_PYTHON_PORT=8000
# Autoreload uvicorn (padre+worker â‰ˆ 2Ã— cold start). Por defecto off en pnpm dev.
# BOLSA_API_RELOAD=1

CORS_ORIGIN=http://localhost:5173

# Web (Vite) â€” apunta a FastAPI Python
VITE_API_URL=http://localhost:8000

# Acceso plataforma (OR-S1)
# Local: vacio = sin login (OK). Demo compartida / staging / prod: OBLIGATORIO.
# APP_PASSWORD=cambia-esto
APP_AUTH_SECRET=bolsa-dev-secret
# ENVIRONMENT=development  # fuera de development/local, health marca auth degraded si falta password

# Redis (cachÃ© indicadores â€” fase 2)
REDIS_URL=redis://localhost:6379/0

# XTB bridge local (opcional â€” cotizaciÃ³n live)
# Mock de desarrollo: node scripts/xtb-bridge-mock.mjs (pnpm dev lo arranca solo)
# Desactivar autostart: XTB_BRIDGE_AUTOSTART=0
XTB_BRIDGE_URL=http://localhost:3002

# D2 — batch EOD dictámenes Estudio (off-by-default; ADR-022)
# ESTUDIO_EOD_OPINION_ENABLED=false
# ESTUDIO_EOD_OPINION_INTERVAL_SECONDS=3600
# Email Alarmas tras eod-batch (requiere SMTP_* + destinatario; off-by-default)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# ESTUDIO_OPINION_EMAIL_ENABLED=false
# ESTUDIO_OPINION_EMAIL_TO=


# Camino D / AUTO execute (A2–A5) — default OFF. No activar sin checklist thaw + ADR-023.
# PAPER_D_EXECUTE=0
# PAPER_D_ACCOUNT_ID=   # A5 opt-in: solo esta cuenta DEMO

# OR-RE — Risk Engine kill switch (aperturas automaticas; UI tambien en Operativa)
# RISK_KILL_SWITCH=false
