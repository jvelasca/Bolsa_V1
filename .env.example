# Database (local Docker)
DATABASE_URL="postgresql://bolsa:bolsa_dev@localhost:5432/bolsa_v1?schema=public"

# API (TypeScript legacy — retirar tras cutover Python)
API_HOST=0.0.0.0
API_PORT=3001

# API Python (FastAPI — objetivo)
API_PYTHON_HOST=0.0.0.0
API_PYTHON_PORT=8000
# Autoreload uvicorn (padre+worker ≈ 2× cold start). Por defecto off en pnpm dev.
# BOLSA_API_RELOAD=1

CORS_ORIGIN=http://localhost:5173

# Web (Vite) — apunta a FastAPI Python
VITE_API_URL=http://localhost:8000

# Acceso plataforma (opcional; vacío = sin login en dev)
# APP_PASSWORD=cambia-esto
APP_AUTH_SECRET=bolsa-dev-secret

# Redis (caché indicadores — fase 2)
REDIS_URL=redis://localhost:6379/0

# XTB bridge local (opcional — cotización live)
# Mock de desarrollo: node scripts/xtb-bridge-mock.mjs (pnpm dev lo arranca solo)
# Desactivar autostart: XTB_BRIDGE_AUTOSTART=0
XTB_BRIDGE_URL=http://localhost:3002

# D2 � batch EOD dict�menes Estudio (off-by-default; ADR-022)
# ESTUDIO_EOD_OPINION_ENABLED=false
# ESTUDIO_EOD_OPINION_INTERVAL_SECONDS=3600
