# Database (local Docker)
DATABASE_URL="postgresql://bolsa:bolsa_dev@localhost:5432/bolsa_v1?schema=public"
# Retención de backups locales (db-backups/) en `pnpm db:dump` — default 14
# DB_BACKUP_KEEP=14

# API (TypeScript legacy â€” retirar tras cutover Python)
API_HOST=0.0.0.0
API_PORT=3001

# API Python (FastAPI â€” objetivo)
API_PYTHON_HOST=0.0.0.0
API_PYTHON_PORT=8000
# Autoreload uvicorn (padre+worker â‰ˆ 2Ã— cold start). Por defecto off en pnpm dev.
# BOLSA_API_RELOAD=1

CORS_ORIGIN=http://localhost:5173

# Web (Vite) â€” apunta a FastAPI Python
VITE_API_URL=http://localhost:8000

# Acceso plataforma (OR-S1/S1.1)
# Local: APP_PASSWORD vacío = sin login (OK). Demo compartida / staging / prod: OBLIGATORIO.
# APP_PASSWORD=cambia-esto
# APP_AUTH_SECRET es el secreto de firma de sesión. OBLIGATORIO cuando APP_PASSWORD
# está definido, y NO puede ser 'bolsa-dev-secret'. Genera uno:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Con APP_PASSWORD vacío puede dejarse vacío (auth desactivado).
# APP_AUTH_SECRET=
# ENVIRONMENT=development  # fuera de development/local, health marca auth degraded si falta password
#
# Exposición en red (auditoría externa 2026-11-08)
# `pnpm dev` bindea Vite y la API de desarrollo en LOOPBACK (127.0.0.1). Antes, Vite usaba
# `host: true` y la web quedaba expuesta en CUALQUIER arranque.
# Para abrir la web a la LAN: `pnpm dev:lan` (exige APP_PASSWORD + APP_AUTH_SECRET y pone
# WEB_HOST=0.0.0.0). La API sigue en loopback y Vite le reenvía: con el proxy, la API ve
# las peticiones como loopback, así que un parche de loopback de la API NO protege la LAN.
# La protección real es la autenticación (o no bindear). WEB_HOST/API_HOST permiten
# override explícito, pero no son la vía recomendada.
# WEB_HOST=127.0.0.1
# API_HOST=127.0.0.1

# Redis (cachÃ© indicadores â€” fase 2)
REDIS_URL=redis://localhost:6379/0

# XTB bridge local (opcional â€” cotizaciÃ³n live)
# Mock de desarrollo: node scripts/xtb-bridge-mock.mjs (pnpm dev lo arranca solo)
# Desactivar autostart: XTB_BRIDGE_AUTOSTART=0
XTB_BRIDGE_URL=http://localhost:3002

# D2 — batch EOD dictámenes Estudio (off-by-default; ADR-022)
# ESTUDIO_EOD_OPINION_ENABLED=false
# ESTUDIO_EOD_OPINION_INTERVAL_SECONDS=3600
# Email Alarmas tras eod-batch (requiere SMTP_* + destinatario; off-by-default)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# ESTUDIO_OPINION_EMAIL_ENABLED=false
# ESTUDIO_OPINION_EMAIL_TO=
# Digest operativo diario HTML (R3 � mismo SMTP / destinatario Alarmas; off-by-default)
# DAILY_OPS_DIGEST_EMAIL_ENABLED=false
# Adjuntar PDF al digest (R4 � off-by-default)
# DAILY_OPS_DIGEST_PDF_ENABLED=false
#
# SMTP: la contrase�a es del SERVIDOR de correo (App Password), no del usuario de Bolsa.
# Gmail: Cuenta Google ? Seguridad ? Verificaci�n en 2 pasos ? Contrase�as de aplicaciones
#   ? generar 16 caracteres y ponerlos en SMTP_PASSWORD (sin espacios).
# SMTP_FROM debe ser la misma cuenta que SMTP_USER.


# Camino D / AUTO execute — thaw BETA-D Accepted (ADR-023 2026-08-25).
# Default OFF en repo. Opt-in local DEMO only (no broker · no demo compartida sin anotar):
# PAPER_D_EXECUTE=1
# PAPER_D_ACCOUNT_ID=default-account-seed

# W4 (v2.88.17) — precio REAL del motor AUTO (mata el 100.0 plano de flat_price_script).
# Default OFF (costura inerte: CI/tests y replay byte a byte, Δ = 0). Encender =1 en DESPLIEGUE
# y en la ventana PAPER/forward: el motor lee el open de la barra D1 de hoy; sin esa barra el
# símbolo queda en HOLD y el turno BLOCKED (fail-closed declarado; jamás 100.0/0 silencioso).
# AUTO_ENGINE_SIM_REAL_PRICE=1

# R-4 (cierre 2026-10-26) — IDENTIDAD DEL MOTOR AUTO. OBLIGATORIA cuando el worker arranca
# con composición PostgreSQL (scheduler/servidor). Sin ella el arranque durable FALLA
# (EngineIdentityMissingError) y AUTO queda apagado en ese proceso, mientras el resto de
# workers arranca: el fallo se acota a propósito. Dos procesos que caigan al default
# `auto-sim` comparten filas de proyección y latch, y la reconciliación deja de identificar
# al motor. En la ventana PAPER el runner ya fija `auto-window-1484e253`
# (scripts/lib/window-forward.mjs): el despliegue debe declarar la suya y ser ESTABLE.
# AUTO_ENGINE_SIM_ENGINE_ID=auto-sim-prod-1

# ── AUTO: interruptores y números (auditoría externa 2026-11-08) ──────────────────────────
# Todos nacen APAGADOS/VACÍOS en el repo. Un default apagado no es neutral: cambia lo que
# hace el motor. `GET /api/health` publica el bloque `auto_runtime` con el valor EFECTIVO y
# los avisos; el arranque del worker los escribe en el log. `pnpm dev:auto` enciende este
# perfil completo (worker + V2 + precio real + gobernador + ATR + corte de drawdown) sin
# tocar `pnpm dev`, que sigue sin activar AUTO.
#
# Worker AUTO (SIM). Default OFF: sin esto no hay motor autónomo.
# AUTO_SIMULATION_WORKER_ENABLED=0
#
# Motor V2 (pipeline de decisión medido). Default OFF: con el worker ON y esto OFF se opera
# el camino legacy, que NO es el que se midió.
# AUTO_ENGINE_SIM_V2=0
#
# Gobernador de drawdown. Default OFF: no escala ni veta por caída de equity.
# AUTO_ENGINE_SIM_V2_GOVERNOR=0
#
# Exigir ATR real para dimensionar el stop. Default OFF: un ATR sintético (2 % del precio)
# puede dimensionar la posición.
# AUTO_ENGINE_SIM_V2_ATR_REQUIRED=0
#
# Corte de drawdown de cuenta pico-valle (%). Vacío = OFF (no hay corte). Si se define y el
# drawdown medido lo supera, solo se vetarán APERTURAS; las salidas protectoras siguen.
# AUTO_ENGINE_SIM_V2_ACCOUNT_MAX_DD_PCT=
#
# Modelo de coste del sizing (comisión/spread/slippage dentro del riesgo). Default ON en el
# motor; se declara aquí para que el perfil dev lo fije explícitamente en 10/5/2.
# AUTO_ENGINE_SIM_V2_COST_MODEL=1
# AUTO_ENGINE_SIM_V2_COMMISSION_BPS=10
# AUTO_ENGINE_SIM_V2_SPREAD_BPS=2
# AUTO_ENGINE_SIM_V2_SLIPPAGE_BPS=5
#
# Equity de la cuenta SIM (punto de partida del drawdown pico-valle).
# AUTO_ENGINE_SIM_V2_EQUITY=100000

# OR-RE — Risk Engine kill switch (aperturas automaticas; UI tambien en Operativa)
# RISK_KILL_SWITCH=false
