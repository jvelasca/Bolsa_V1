{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bolsa: Dev doctor",
      "type": "shell",
      "command": "node scripts/dev-doctor.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": false },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "bolsa" },
      "problemMatcher": []
    },
    {
      "label": "Bolsa: Dev verify",
      "type": "shell",
      "command": "node scripts/dev-verify.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "bolsa" },
      "problemMatcher": []
    },
    {
      "label": "Bolsa: Liberar puertos dev",
      "type": "shell",
      "command": "node scripts/dev-doctor.mjs --fix-ports",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Bolsa: Docker + PostgreSQL",
      "type": "shell",
      "command": "node scripts/db-ensure.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": [],
      "detail": "Primera vez o tras reiniciar PC — NO se ejecuta en F5"
    },
    {
      "label": "Bolsa: Esperar API",
      "type": "shell",
      "command": "node scripts/wait-api-health.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Bolsa: F5 Dev",
      "type": "shell",
      "command": "node scripts/run-dev.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "isBackground": true,
      "problemMatcher": {
        "owner": "bolsa-dev",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Iniciando stack",
          "endsPattern": "Web lista ->"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "bolsa" }
    },
    {
      "label": "Bolsa: Health check",
      "type": "shell",
      "command": "node scripts/health-check.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Bolsa: Setup inicial",
      "type": "shell",
      "command": "node scripts/setup.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always" },
      "problemMatcher": []
    }
  ]
}
